# Copy to `.env.local` for local dev, and set the same names in your host's
# environment-variable settings (Vercel / Cloudflare Pages / Netlify).
#
# Everything prefixed VITE_ is inlined into the client bundle and is publicly
# readable. That is why there are no AI provider keys here any more.

# ── Supabase ──────────────────────────────────────────────────────────────
# Public by design. Safety comes from row-level security, not from secrecy.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Legacy name, still read as a fallback so an older deploy keeps working.
# VITE_SUPABASE_ANON_KEY=eyJ...

VITE_SITE_URL=http://localhost:5173

# Set to "false" to build with every AI feature disabled. Note that the AI
# surfaces are already off automatically when Supabase is unconfigured — there
# is no separate provider key for the client to check.
# VITE_AI_ENABLED=true

# ── AI provider keys: NOT HERE ────────────────────────────────────────────
#
# VITE_HCNSEC_KEY and VITE_OPENROUTER_KEY used to live in this file. They were
# inlined into the bundle and readable by anyone who opened devtools.
#
# Every provider key is now server-side, reachable only from a Supabase Edge
# Function. See supabase/.env.forge.example, and push them with:
#
#     npm run forge:secrets
#
# If you are migrating an existing deploy: delete VITE_HCNSEC_KEY and
# VITE_OPENROUTER_KEY from your host's environment, and rotate both keys —
# anything that shipped in a bundle should be treated as public.
