# Forge AI — Edge Function secrets.
#
# Copy to `supabase/.env.forge`, fill in real values, then push them:
#
#     npx supabase login
#     npx supabase link --project-ref kavfjyvsvgvcjiuwwfbw
#     npx supabase secrets set --env-file supabase/.env.forge
#
# `supabase/.env.forge` is gitignored (the root `.env.*` rule covers it).
# NOTHING here is VITE_-prefixed, and nothing here is ever read by the client:
# these values exist only inside an Edge Function. That is the entire point of
# the server tier.
#
# Supabase injects SUPABASE_URL, SUPABASE_DB_URL, SUPABASE_JWKS,
# SUPABASE_SECRET_KEYS and SUPABASE_SERVICE_ROLE_KEY automatically. Do not set
# them here.

FORGE_NVIDIA_KEY=nvapi-...
FORGE_HCNSEC_KEY=sk-...
FORGE_OPENROUTER_KEY=sk-or-v1-...

# KiraAI: the /v1/models endpoint needs no auth, so a 200 there is NOT evidence
# of a working key. Leave this unset until a key authenticates against
# /v1/chat/completions — the provider is simply absent from every ladder while
# it is empty, which is a supported configuration.
FORGE_KIRA_KEY=

# OpenRouter attribution. Set to the deployed origin.
FORGE_SITE_URL=https://typeforge.app

# Set to "false" to disable every AI surface without removing keys.
# FORGE_AI_ENABLED=true
